# Configuracao do verificador operacional - VALORES DE LABORATORIO, ficticios.
# Copiar para o CONFIG_FILE da implantacao (ex.: /etc/cartorio-lab/ops.env, 0640).
# Sem segredo aqui: a DSN vem do db.env do proprio app (segundo EnvironmentFile=).
CARTORIO_OPS_CHECKS=api,database,alembic,backup
CARTORIO_OPS_TIMEOUT_SECONDS=5
CARTORIO_OPS_HEALTH_URL=http://127.0.0.1:8000/api/v1/health
CARTORIO_OPS_EXPECTED_APP_NAME="Cartorio System - Laboratorio"
# Instancia do cluster, nunca o guarda-chuva postgresql.service (reporta active
# mesmo com o cluster parado).
CARTORIO_OPS_UNITS=cartorio-lab.service:service,postgresql@18-main.service:service
CARTORIO_OPS_EXPECTED_DIALECT=postgresql
CARTORIO_OPS_RELEASE_DIR=/opt/cartorio-lab/current
CARTORIO_OPS_BACKUP_DIR=/var/lib/cartorio-lab-backups/recorrentes
# Laboratorio: rotina diaria (com atraso aleatorio de alguns minutos) mais folga.
# O limiar real e decisao de implantacao; a meta Classe 3 (CNJ 213) e RPO <= 4 h.
CARTORIO_OPS_BACKUP_MAX_AGE_HOURS=26
# Banco de que as copias precisam ser (campo "database" do manifesto). Com as checagens
# database e backup juntas em PostgreSQL, vale o banco que a conexao abriu de fato, e esta
# variavel, se definida, precisa coincidir com ele. Obrigatoria no backup isolado sem DSN
# PostgreSQL e em bancada SQLite.
# CARTORIO_OPS_BACKUP_EXPECTED_DATABASE=cartorio_lab
CARTORIO_OPS_BACKUP_SERVICE_UNIT=cartorio-lab-backup.service
CARTORIO_OPS_BACKUP_TIMER_UNIT=cartorio-lab-backup.timer
# Opcional: relatorio do ultimo ensaio de restauracao (python -m app.ops.drill).
# CARTORIO_OPS_RESTORE_EVIDENCE=/var/lib/cartorio-lab-ops/restore-drill.json
# CARTORIO_OPS_RESTORE_MAX_AGE_DAYS=35
